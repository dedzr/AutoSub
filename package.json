    "scripts": {
        "client-install": "cd frontend && npm install",
        "client-build": "cd frontend && npm run build",
        "server-install": "cd backend && npm install",
        "clean-build": "rimraf backend/build",
        "copy-build": "copyfiles -u 2 frontend/dist/**/* backend/build",
