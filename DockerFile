# ====== Stage 1: Build Node frontend ======
FROM node:18-alpine AS client-build

WORKDIR /app
COPY frontend ./frontend
RUN cd frontend && npm install && npm run build

# ====== Stage 2: Full backend app with Whisper and FFmpeg ======
FROM python:3.10-alpine AS backend

# Install minimal system dependencies
RUN apk add --no-cache ffmpeg bash curl build-base

# Set working directory
WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch==2.0.1+cpu torchvision==0.15.2+cpu \
      -f https://download.pytorch.org/whl/cpu/torch_stable.html && \
    pip install --no-cache-dir openai-whisper && \
    pip install --no-cache-dir -r requirements.txt

# Copy backend source code
COPY backend ./backend

# Copy the built frontend into backend's build directory
COPY --from=client-build /app/frontend/dist ./backend/build

# Install Node.js manually (since Alpine Python image doesn't come with it)
# Use Node 18 from Alpine repo
RUN apk add --no-cache nodejs npm

# Install backend Node dependencies
WORKDIR /app/backend
RUN npm install

# App config
ENV PORT=8080
EXPOSE 8080

# Run the backend
CMD ["npm", "start"]
